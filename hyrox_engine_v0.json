    },
    "farmers": {
      "gym":   { "movement": "ダンベル/KB歩行 200m相当（50m×4）", "fidelity": 0.95 },
      "home":  { "movement": "水18Lタンク×2で歩行（約18kg/手）", "fidelity": 0.85 }
    },
    "lunge": {
      "gym":   { "movement": "バーベル/ダンベル歩行ランジ 100m", "fidelity": 0.90 },
      "home":  { "movement": "リュックに20kg（水・本）で歩行ランジ100m", "fidelity": 0.85 }
    },
    "wallball": {
      "gym":   { "movement": "メディシンボールがなければゴブレットスクワット+プレス 100rep", "fidelity": 0.80 },
